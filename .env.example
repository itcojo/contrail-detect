# Copy this file to ~/.env and fill in the values you need. Every variable is optional,
# so set only those relevant to the data sources you use.

# Contrails.org API key, required for Contrails.org detections (method='contrails_api')
# and ADS-B flight data (ContrailsAPIFlightData).
CONTRAILS_API_KEY=your_api_key_here

# Google Contrails API key, required for Google detections (method='google_api').
GOOGLE_CONTRAILS_API_KEY=your_api_key_here
