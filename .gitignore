### --- --- --- --- --- --- --- --- --- --- --- --- --- --- ###
### Data ###
# Do not keep any unexpected data entries
contrail_detect/data/*
!contrail_detect/data/geostationary_data/

# Do not keep any CoCiP forecast/reanalysis data (but keep structure)
contrail_detect/data/cocip_data/*
!contrail_detect/data/cocip_data/.gitkeep

# Do not keep any ECMWF forecast/reanalysis data (but keep structure)
contrail_detect/data/ecmwf_data/*
!contrail_detect/data/ecmwf_data/.gitkeep

# Do not keep any satellite data
contrail_detect/data/geostationary_data/*
!contrail_detect/data/geostationary_data/mtg_summer_scantime.npz
!contrail_detect/data/geostationary_data/mtg_winter_scantime.npz
!contrail_detect/data/geostationary_data/abi_time_model_mode6a.npz

# Do not keep any flight data
contrail_detect/data/flight_data/*
!contrail_detect/data/flight_data/test_flight_data.parquet

# Do not keep any inference data (but keep structure)
contrail_detect/data/inference_data/*
!contrail_detect/data/inference_data/.gitkeep

# Do not keep any processed contrail data (but keep structure)
contrail_detect/data/processed_data/*
!contrail_detect/data/processed_data/.gitkeep

# Do not keep any tmp data (but keep structure)
contrail_detect/data/tmp/*
!contrail_detect/data/tmp/.gitkeep

# Do not keep any data within kaggle temp directory
contrail_detect/models/kaggle_contrails_solution/data/*
!contrail_detect/models/kaggle_contrails_solution/data/.gitkeep


